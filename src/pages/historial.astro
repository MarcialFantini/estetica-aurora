---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuroraDivider from "../components/AuroraDivider.astro";
import HistorialLookup from "../components/historial/HistorialLookup";
---

<Base
  title="Mis reservas - Estética Aurora"
  description="Buscá tus reservas por número de teléfono. Próximas, pasadas y canceladas."
  active="historial"
>
  <Header slot="header" active="historial" />

  <section class="container-x pt-28 sm:pt-36">
    <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
      Historial
    </p>
    <h1 class="display-italic mt-3 max-w-[18ch] font-serif text-[clamp(2.2rem,6vw,4.4rem)] leading-[1.04] text-[var(--color-ink)]">
      Tus reservas, <em>a un teléfono</em> de distancia.
    </h1>
    <p class="mt-6 max-w-[60ch] text-[16px] leading-relaxed text-[var(--color-ink-2)]">
      Ingresá el teléfono con el que hiciste las reservas y te mostramos las
      próximas, las que ya pasaron y las que cancelaste.
    </p>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-7">
        <HistorialLookup client:load />
      </div>
      <aside class="reveal lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
            Cómo funciona
          </p>
          <h2 class="mt-3 font-serif text-[22px] leading-[1.1] text-[var(--color-ink)]">
            Buscamos en este navegador, no en un servidor.
          </h2>
          <p class="mt-4 text-[14.5px] leading-relaxed text-[var(--color-ink-2)]">
            Las reservas viven en el almacenamiento local del navegador donde
            las hiciste. Si reservaste desde otro dispositivo o navegador, esa
            información no la vemos desde acá.
          </p>
          <ul class="mt-6 grid gap-3 text-[14px] leading-relaxed text-[var(--color-ink-2)]">
            <li class="flex gap-3">
              <span
                class="mt-1 inline-block h-1.5 w-1.5 flex-none rounded-full"
                style="background: var(--color-clay);"
                aria-hidden="true"
              />
              <span>
                Las búsquedas solo cotejan dígitos. Da igual si ingresás con o
                sin espacios, con o sin prefijo +54.
              </span>
            </li>
            <li class="flex gap-3">
              <span
                class="mt-1 inline-block h-1.5 w-1.5 flex-none rounded-full"
                style="background: var(--color-clay);"
                aria-hidden="true"
              />
              <span>
                Desde acá podés modificar, cancelar o descargar el comprobante
                de cada reserva.
              </span>
            </li>
            <li class="flex gap-3">
              <span
                class="mt-1 inline-block h-1.5 w-1.5 flex-none rounded-full"
                style="background: var(--color-clay);"
                aria-hidden="true"
              />
              <span>
                Si no aparecen tus reservas, probá con el teléfono completo con
                código de país.
              </span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</Base>