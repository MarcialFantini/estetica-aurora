---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuroraDivider from "../components/AuroraDivider.astro";
import { profesionales } from "../data/servicios";

const INTERIOR_IMAGE =
  "https://picsum.photos/seed/aurora-peluqueria-mostrador-v2/1280/900";
const EQUIPO_IMAGE =
  "https://picsum.photos/seed/aurora-peluqueria-equipo-v2/1280/900";
---

<Base
  title="Sobre nosotras - Estética Aurora"
  description="Conocé al equipo de Estética Aurora y la historia del salón. Cinco profesionales especializadas en color, corte, tratamientos y peinados."
  active="sobre-nosotras"
>
  <Header slot="header" active="sobre-nosotras" />

  <section class="container-x pt-28 sm:pt-36">
    <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
      Sobre nosotras
    </p>
    <h1 class="display-italic mt-3 max-w-[18ch] font-serif text-[clamp(2.2rem,6vw,4.4rem)] leading-[1.04] text-[var(--color-ink)]">
      Una peluquería <em>pequeña</em> con cinco cabezas y un patio interno.
    </h1>
    <p class="mt-6 max-w-[60ch] text-[16px] leading-relaxed text-[var(--color-ink-2)]">
      Estética Aurora abrió en 2014 como un local de dos sillones en el centro. Hoy
      atendemos con cinco profesionales, abrimos los sábados hasta las 21:00 y somos
      el lugar donde vuelven las clientas que atendemos hace diez años.
    </p>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-7">
        <h2 class="display-italic font-serif text-[clamp(1.9rem,4vw,2.8rem)] leading-[1.05] text-[var(--color-ink)]">
          Nuestra <em>historia</em>
        </h2>
        <div class="mt-6 grid gap-5 text-[15.5px] leading-relaxed text-[var(--color-ink-2)]">
          <p>
            Arrancamos en una esquina sobre la calle 9 de Julio. En ese entonces, Mariana
            —la fundadora— atendía sola los seis días de la semana, con una lista de
            espera que manejaba por WhatsApp. Lo que empezó como una peluquería de barrio
            se transformó en el equipo que somos hoy.
          </p>
          <p>
            Cuando abrimos las puertas ya teníamos claro lo que no queríamos ser: no
            queríamos una peluquería Express que te atiende en quince minutos ni un
            spa con carta de tragos. Queríamos un lugar donde la clienta entra, se
            sienta, charle con quien le corta y salga sintiéndose atendida — no
            apurada.
          </p>
          <p>
            Eso sigue definiendo cómo trabajamos. Si venís a cortarte el pelo, te
            lavamos, te secamos y te damos nuestro consejo honesto sobre cómo cuidarlo
            hasta la próxima visita. Si tenés un evento, agendamos una prueba y vemos
            qué te queda mejor.
          </p>
        </div>
      </div>
      <div class="reveal lg:col-span-5">
        <div class="bezel-shell">
          <div class="bezel-core overflow-hidden">
            <img
              src={INTERIOR_IMAGE}
              alt="Mostrador del salón con luz cálida"
              width="1280"
              height="900"
              loading="lazy"
              class="h-full w-full object-cover"
              style="aspect-ratio: 4 / 5;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12">
    <header class="grid gap-6 sm:grid-cols-12 sm:items-end">
      <div class="reveal sm:col-span-7">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
          Equipo
        </p>
        <h2 class="display-italic mt-3 font-serif text-[clamp(1.9rem,4vw,2.8rem)] leading-[1.05] text-[var(--color-ink)]">
          Las que <em>te atienden</em>.
        </h2>
      </div>
      <p class="reveal text-[15px] leading-relaxed text-[var(--color-ink-2)] sm:col-span-5">
        Cinco profesionales, cinco especialidades. Si querés venir con alguien
        específico, agendá con su nombre; si te da lo mismo, te asignamos a la
        primera que se libere.
      </p>
    </header>

    <ul class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[rgba(31,24,18,0.08)] bg-[rgba(31,24,18,0.08)] sm:grid-cols-2 lg:grid-cols-3">
      {
        profesionales.map((p) => (
          <li class="p-7" style="background: var(--color-paper-2);">
            <div class="flex items-center gap-4">
              <span
                aria-hidden="true"
                class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-full text-[13px] font-medium"
                style="background: var(--color-clay); color: var(--color-paper-2);"
              >
                {p.iniciales ?? p.nombre.split(" ").map((n) => n[0]).slice(0, 2).join("")}
              </span>
              <div>
                <p class="font-serif text-[19px] leading-tight text-[var(--color-ink)]">
                  {p.nombre}
                </p>
                <p class="mt-1 text-[12px] text-[var(--color-muted)]">
                  {p.aniosExperiencia} años de experiencia
                </p>
              </div>
            </div>
            <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-clay)]">
              {p.especialidad}
            </p>
            <p class="mt-4 text-[14px] leading-relaxed text-[var(--color-ink-2)]">
              {p.bio}
            </p>
            <a
              href={`/reservar?profesional=${p.id}`}
              class="mt-5 inline-flex items-center gap-1.5 text-[13px] text-[var(--color-clay)] transition-transform duration-300 hover:translate-x-0.5"
            >
              Reservar con {p.nombre.split(" ")[0]}
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-6">
        <h2 class="display-italic font-serif text-[clamp(1.9rem,4vw,2.8rem)] leading-[1.05] text-[var(--color-ink)]">
          El <em>espacio</em>.
        </h2>
        <div class="mt-6 grid gap-5 text-[15px] leading-relaxed text-[var(--color-ink-2)]">
          <p>
            El salón ocupa una casa antigua reciclada. Tiene tres sillones, dos
            lavacabezas y un patio interno al que se abre la ventana del fondo.
            Cuando hace calor, dejamos la puerta abierta.
          </p>
          <p>
            Trabajamos con productos sin amoníaco para coloración, keratina de
            marca registrada y herramientas térmicas reguladas a 185° como máximo.
            Si tenés una alergia o necesitás un producto específico, contanoslo
            cuando reserves y lo tenemos listo.
          </p>
          <ul class="mt-4 grid gap-3 text-[14px]">
            <li class="flex gap-3">
              <span class="font-mono text-[11px] tabular-nums text-[var(--color-clay)]">01</span>
              <span><strong class="font-medium text-[var(--color-ink)]">Sin amoníaco</strong>: coloración con líneas profesionales que cuidan la fibra.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-mono text-[11px] tabular-nums text-[var(--color-clay)]">02</span>
              <span><strong class="font-medium text-[var(--color-ink)]">Temperatura regulada</strong>: planchas y secadores a 185° como máximo.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-mono text-[11px] tabular-nums text-[var(--color-clay)]">03</span>
              <span><strong class="font-medium text-[var(--color-ink)]">Prueba previa</strong> para novias y eventos: agendamos un ensayo antes del día.</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="reveal lg:col-span-6">
        <div class="bezel-shell">
          <div class="bezel-core overflow-hidden">
            <img
              src={EQUIPO_IMAGE}
              alt="Equipo de Estética Aurora"
              width="1280"
              height="900"
              loading="lazy"
              class="h-full w-full object-cover"
              style="aspect-ratio: 4 / 5;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12 mb-32">
    <div class="bezel-shell">
      <div
        class="bezel-core flex flex-col items-start gap-6 p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between"
        style="background: var(--color-clay); color: var(--color-paper-2);"
      >
        <div>
          <p class="display-italic font-serif text-[clamp(1.8rem,4vw,2.6rem)] leading-[1.1]">
            ¿Te imaginás <em>cómo te quedaría</em>?
          </p>
          <p class="mt-3 max-w-[42ch] text-[15px] leading-relaxed text-[rgba(250,244,234,0.86)]">
            Reservá un turno y dejános ayudarte a decidir qué te favorece. Si tenés
            una foto de referencia, traela — la vemos juntas.
          </p>
        </div>
        <a
          href="/reservar"
          class="btn-pill"
          style="background: var(--color-paper-2); color: var(--color-clay);"
        >
          <span>Sacar un turno</span>
          <span
            class="icon-bubble !h-5 !w-5"
            style="background: rgba(122, 61, 46, 0.14);"
            aria-hidden="true"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>