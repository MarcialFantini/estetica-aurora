---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuroraDivider from "../components/AuroraDivider.astro";
import { DIAS_SEMANA } from "../lib/horarios";

const HORARIO_INICIO = "09:00";
const HORARIO_FIN = "19:00";
const HORARIO_FIN_SAB = "21:00";
---

<Base
  title="Contacto - Estética Aurora"
  description="Cómo llegar a Estética Aurora, nuestros horarios y datos de contacto."
  active="contacto"
>
  <Header slot="header" active="contacto" />

  <section class="container-x pt-28 sm:pt-36">
    <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
      Contacto
    </p>
    <h1 class="display-italic mt-3 max-w-[18ch] font-serif text-[clamp(2.2rem,6vw,4.4rem)] leading-[1.04] text-[var(--color-ink)]">
      Estamos <em>a tres cuadras</em> de la plaza.
    </h1>
    <p class="mt-6 max-w-[60ch] text-[16px] leading-relaxed text-[var(--color-ink-2)]">
      Atendemos con turno previo. Si necesitás reservar, este sitio web es la forma
      más rápida — pero si te queda más cómodo llamar o mandar un mail, también
      funciona.
    </p>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-7">
        <div class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[rgba(31,24,18,0.08)] bg-[rgba(31,24,18,0.08)] sm:grid-cols-2">
          <article class="p-7" style="background: var(--color-paper-2);">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
              Dirección
            </p>
            <p class="mt-4 font-serif text-[20px] leading-[1.2] text-[var(--color-ink)]">
              Av. de los Aromos 1420
            </p>
            <p class="mt-1 text-[14px] text-[var(--color-ink-2)]">
              Centro, entre 9 de Julio y San Martín
            </p>
            <p class="mt-4 text-[13px] text-[var(--color-muted)]">
              A tres cuadras de la plaza principal. Referencia: frente a la
              farmacia del Ángel.
            </p>
          </article>
          <article class="p-7" style="background: var(--color-paper-2);">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
              Teléfono
            </p>
            <a
              class="mt-4 block font-serif text-[20px] leading-[1.2] text-[var(--color-ink)] underline-offset-4 hover:underline"
              href="tel:+5491145551234"
            >
              +54 9 11 4555-1234
            </a>
            <p class="mt-1 text-[14px] text-[var(--color-ink-2)]">
              Llamadas y WhatsApp
            </p>
            <p class="mt-4 text-[13px] text-[var(--color-muted)]">
              Atendemos llamadas de 9:00 a 19:00. Después de hora, dejá mensaje
              y respondemos al día siguiente.
            </p>
          </article>
          <article class="p-7" style="background: var(--color-paper-2);">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
              Email
            </p>
            <a
              class="mt-4 block font-serif text-[20px] leading-[1.2] text-[var(--color-ink)] underline-offset-4 hover:underline"
              href="mailto:reservas@aurora.local"
            >
              reservas@aurora.local
            </a>
            <p class="mt-1 text-[14px] text-[var(--color-ink-2)]">
              Para reservas y consultas generales
            </p>
            <p class="mt-4 text-[13px] text-[var(--color-muted)]">
              Respondemos en horario comercial. Si necesitás una respuesta
              urgente, llamanos.
            </p>
          </article>
          <article class="p-7" style="background: var(--color-paper-2);">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
              Horarios
            </p>
            <ul class="mt-4 grid grid-cols-2 gap-y-2 text-[14px] leading-relaxed">
              <li class="text-[var(--color-ink-2)]">Lunes a viernes</li>
              <li class="text-right font-mono tabular-nums text-[var(--color-ink)]">
                {HORARIO_INICIO} - {HORARIO_FIN}
              </li>
              <li class="text-[var(--color-ink-2)]">Sábados</li>
              <li class="text-right font-mono tabular-nums text-[var(--color-ink)]">
                {HORARIO_INICIO} - {HORARIO_FIN_SAB}
              </li>
              <li class="text-[var(--color-ink-2)]">{DIAS_SEMANA[6]}</li>
              <li class="text-right text-[var(--color-muted)]">Cerrado</li>
            </ul>
            <p class="mt-4 text-[13px] text-[var(--color-muted)]">
              Los sábados extendimos hasta las 21:00 para casamientos y eventos.
            </p>
          </article>
        </div>
      </div>

      <aside class="reveal lg:col-span-5">
        <div class="bezel-shell lg:sticky lg:top-32">
          <div
            class="bezel-core flex flex-col gap-5 p-8"
            style="background: var(--color-paper-3);"
          >
            <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
              ¿Primera visita?
            </p>
            <h2 class="font-serif text-[24px] leading-[1.1] text-[var(--color-ink)]">
              Si nunca viniste, agendá un diagnóstico.
            </h2>
            <p class="text-[14px] leading-relaxed text-[var(--color-ink-2)]">
              Cuando es la primera vez que venís, sumamos 15 minutos al turno sin
              cargo para revisar tu cabello y proponerte lo que mejor le queda.
              Mencioná "primera visita" en las notas al reservar.
            </p>
            <a href="/reservar" class="btn-pill btn-primary self-start">
              <span>Sacar un turno</span>
              <span class="icon-bubble !h-5 !w-5" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                  <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <AuroraDivider />

  <section class="container-x mt-12 mb-32">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="reveal lg:col-span-6">
        <h2 class="display-italic font-serif text-[clamp(1.9rem,4vw,2.8rem)] leading-[1.05] text-[var(--color-ink)]">
          Cómo <em>llegar</em>.
        </h2>
        <div class="mt-6 grid gap-5 text-[15px] leading-relaxed text-[var(--color-ink-2)]">
          <p>
            La parada del colectivo 24 está a una cuadra; las líneas 12, 38 y 47
            paran a dos. Si venís en subte, la estación más cercana es la de la
            plaza principal, a tres cuadras caminando.
          </p>
          <p>
            En auto hay estacionamiento libre sobre la calle San Martín y un
            parking pago a media cuadra. La puerta del salón está al lado de
            un mural pintado por una clienta hace cuatro años.
          </p>
        </div>
      </div>
      <div class="reveal lg:col-span-6">
        <div
          class="flex aspect-[5/3] items-center justify-center overflow-hidden rounded-[var(--radius-card)] border border-[rgba(31,24,18,0.08)]"
          style="background: var(--color-paper-3);"
          aria-hidden="true"
        >
          <svg viewBox="0 0 200 120" class="h-full w-full" preserveAspectRatio="xMidYMid slice">
            <rect x="20" y="20" width="160" height="80" fill="none" stroke="var(--color-ink-2)" stroke-width="0.6" stroke-dasharray="2 3" />
            <line x1="20" y1="60" x2="180" y2="60" stroke="var(--color-ink-2)" stroke-width="0.6" stroke-dasharray="2 3" />
            <line x1="100" y1="20" x2="100" y2="100" stroke="var(--color-ink-2)" stroke-width="0.6" stroke-dasharray="2 3" />
            <text x="50" y="40" font-family="ui-monospace" font-size="6" fill="var(--color-muted)">9 de Julio</text>
            <text x="150" y="40" font-family="ui-monospace" font-size="6" fill="var(--color-muted)">San Martín</text>
            <text x="20" y="15" font-family="ui-monospace" font-size="6" fill="var(--color-muted)">Plaza principal</text>
            <circle cx="100" cy="60" r="6" fill="var(--color-clay)" />
            <circle cx="100" cy="60" r="12" fill="none" stroke="var(--color-clay)" stroke-width="0.5" opacity="0.4" />
            <text x="110" y="62" font-family="ui-serif" font-size="7" font-style="italic" fill="var(--color-ink)">Aurora</text>
            <text x="110" y="72" font-family="ui-monospace" font-size="5" fill="var(--color-muted)">Av. de los Aromos 1420</text>
          </svg>
        </div>
        <p class="mt-3 text-[12px] text-[var(--color-muted)]">
          Mapa esquemático, no a escala. La plaza principal queda al norte.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>