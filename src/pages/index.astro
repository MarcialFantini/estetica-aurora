---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { servicios, profesionalDelMes } from "../data/servicios";
import { HORARIO_INICIO_STR, HORARIO_FIN_STR, formatPrecio } from "../lib/horarios";

// Picsum seeded photos for atmospheric lifestyle shots. The seed is descriptive
// so they cache meaningfully across renders.
const HERO_IMAGE =
  "https://picsum.photos/seed/aurora-peluqueria-mostrador/1280/900";
const PROFESIONAL_IMAGE =
  "https://picsum.photos/seed/aurora-peluqueria-equipo/1200/900";
const INTERIOR_IMAGE =
  "https://picsum.photos/seed/aurora-peluqueria-interior/1200/900";
---

<Base title="Estética Aurora - Reservá tu turno online" active="inicio">
  <Header slot="header" active="inicio" />

  <!-- HERO -->
  <section class="container-x pt-28 sm:pt-36">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-7">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
          Peluquería unisex - Centro
        </p>
        <h1 class="display-italic mt-5 font-display text-[clamp(2.6rem,7vw,5.4rem)] leading-[1.02] text-[var(--color-ink)]">
          Tu próximo corte <em class="italic">empieza</em> con un turno.
        </h1>
        <p class="mt-6 max-w-[44ch] text-[16px] leading-relaxed text-[var(--color-ink-2)]">
          Reservá en menos de un minuto. Sin llamadas, sin esperar, sin que se te pisen los
          horarios. El equipo de Estética Aurora te confirma y listo.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/reservar" class="btn-pill btn-primary">
            <span>Reservar turno</span>
            <span class="icon-bubble !h-5 !w-5" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
          <a href="#servicios" class="btn-pill btn-ghost">
            <span>Ver servicios</span>
          </a>
        </div>
        <ul class="mt-12 grid grid-cols-3 gap-6 border-t border-[rgba(31,24,18,0.12)] pt-6 text-[13px] text-[var(--color-ink-2)]">
          <li>
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">
              Lunes a sábado
            </p>
            <p class="mt-1 font-display text-[16px] text-[var(--color-ink)]">
              {HORARIO_INICIO_STR} - {HORARIO_FIN_STR}
            </p>
          </li>
          <li>
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">
              Equipo
            </p>
            <p class="mt-1 font-display text-[16px] text-[var(--color-ink)]">3 profesionales</p>
          </li>
          <li>
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">
              Reserva
            </p>
            <p class="mt-1 font-display text-[16px] text-[var(--color-ink)]">
              Confirmación al instante
            </p>
          </li>
        </ul>
      </div>

      <div class="reveal lg:col-span-5">
        <div class="bezel-shell">
          <div class="bezel-core overflow-hidden">
            <img
              src={HERO_IMAGE}
              alt="Mostrador de peluquería con luz cálida entrando por la ventana"
              width="1280"
              height="900"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
              style="aspect-ratio: 4 / 5;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="container-x mt-32 sm:mt-44">
    <header class="grid gap-6 sm:grid-cols-12 sm:items-end">
      <div class="reveal sm:col-span-7">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
          Servicios
        </p>
        <h2 class="display-italic mt-3 font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.05] text-[var(--color-ink)]">
          Lo que <em>ofrecemos</em>, sin paquetes ni letra chica.
        </h2>
      </div>
      <p class="reveal text-[15px] leading-relaxed text-[var(--color-ink-2)] sm:col-span-5">
        Cada servicio tiene una duración estimada. La duración real se confirma en el
        turno según el largo y tipo de cabello.
      </p>
    </header>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[rgba(31,24,18,0.08)] bg-[rgba(31,24,18,0.08)] sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((s) => (
          <li class="group relative p-6 transition-colors duration-500" style="background: var(--color-paper-2);">
            <div class="flex items-baseline justify-between gap-3">
              <span class="font-display text-[20px] leading-tight text-[var(--color-ink)]">
                {s.nombre}
              </span>
              <span class="font-mono text-[12px] tabular-nums text-[var(--color-ink-2)]">
                {formatPrecio(s.precio)}
              </span>
            </div>
            <p class="mt-3 text-[14px] leading-relaxed text-[var(--color-ink-2)]">
              {s.descripcion}
            </p>
            <div class="mt-6 flex items-center justify-between text-[12px]">
              <span class="font-mono uppercase tracking-[0.16em] text-[var(--color-muted)]">
                {s.duracionMin} min
              </span>
              <a
                href={`/reservar?servicio=${s.id}`}
                class="inline-flex items-center gap-1.5 text-[var(--color-clay)] transition-transform duration-300 group-hover:translate-x-0.5"
              >
                Reservar
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- PROFESIONAL DEL MES -->
  <section class="container-x mt-32 sm:mt-44">
    <div class="grid items-end gap-10 sm:grid-cols-12">
      <div class="reveal sm:col-span-6">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
          Profesional del mes
        </p>
        <h2 class="display-italic mt-3 font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.05] text-[var(--color-ink)]">
          {profesionalDelMes.nombre.split(" ")[0]}, en <em>su mejor momento</em>.
        </h2>
        <p class="mt-5 max-w-[44ch] text-[16px] leading-relaxed text-[var(--color-ink-2)]">
          {profesionalDelMes.bio}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/reservar" class="btn-pill btn-primary">
            <span>Reservar con {profesionalDelMes.nombre.split(" ")[0]}</span>
            <span class="icon-bubble !h-5 !w-5" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
          <p class="text-[13px] text-[var(--color-muted)]">
            {profesionalDelMes.aniosExperiencia} años de experiencia
          </p>
        </div>
      </div>
      <div class="reveal sm:col-span-6">
        <div class="bezel-shell">
          <div class="bezel-core overflow-hidden">
            <img
              src={PROFESIONAL_IMAGE}
              alt={`Retrato de ${profesionalDelMes.nombre} trabajando con una clienta`}
              width="1200"
              height="900"
              loading="lazy"
              class="h-full w-full object-cover"
              style="aspect-ratio: 4 / 5;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO / TIMELINE -->
  <section class="container-x mt-32 sm:mt-44">
    <div class="grid gap-10 sm:grid-cols-12">
      <div class="reveal sm:col-span-5">
        <h2 class="display-italic font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.05] text-[var(--color-ink)]">
          Reservar lleva <em>tres minutos</em>.
        </h2>
        <p class="mt-5 max-w-[40ch] text-[15px] leading-relaxed text-[var(--color-ink-2)]">
          Sin formularios eternos, sin mails de confirmación, sin esperar al teléfono libre.
          Elegís servicio, día y horario, y listo.
        </p>
      </div>

      <ol class="reveal space-y-px sm:col-span-7">
        {
          [
            {
              t: "Elegí el servicio",
              d: "Corte, color, brushing o tratamiento. La duración real se confirma en el turno.",
            },
            {
              t: "Elegí el día y la hora",
              d: "Ves los horarios disponibles en tiempo real, según cada profesional.",
            },
            {
              t: "Dejanos tus datos",
              d: "Nombre, teléfono y email. Tu reserva se guarda y te llevamos al comprobante.",
            },
          ].map((step, i) => (
            <li class="grid grid-cols-12 gap-4 border-t border-[rgba(31,24,18,0.12)] py-6">
              <span
                class="col-span-2 font-mono text-[12px] tabular-nums sm:col-span-1"
                style="color: var(--color-clay);"
              >
                0{i + 1}
              </span>
              <div class="col-span-10 sm:col-span-11">
                <p class="font-display text-[19px] leading-tight text-[var(--color-ink)]">
                  {step.t}
                </p>
                <p class="mt-2 text-[14px] leading-relaxed text-[var(--color-ink-2)]">
                  {step.d}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- INTERIOR BAND -->
  <section class="container-x mt-32 sm:mt-44">
    <div class="reveal grid gap-px overflow-hidden rounded-[var(--radius-card)] sm:grid-cols-12">
      <div class="sm:col-span-7">
        <img
          src={INTERIOR_IMAGE}
          alt="Interior del salón con sillones y plantas"
          width="1200"
          height="900"
          loading="lazy"
          class="h-full w-full object-cover"
          style="aspect-ratio: 4 / 3;"
        />
      </div>
      <div
        class="flex flex-col justify-between gap-6 p-8 sm:col-span-5 sm:p-10"
        style="background: var(--color-clay); color: var(--color-paper-2);"
      >
        <div>
          <p class="display-italic font-display text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.1]">
            Un salón <em>pequeño</em> con tiempo para cada cliente.
          </p>
          <p class="mt-5 max-w-[36ch] text-[15px] leading-relaxed text-[rgba(250,244,234,0.86)]">
            Tres sillones, un equipo que se conoce hace años y una agenda que por fin
            deja de pisar horarios. Esa es Estética Aurora.
          </p>
        </div>
        <a
          href="/reservar"
          class="btn-pill self-start"
          style="background: var(--color-paper-2); color: var(--color-clay);"
        >
          <span>Sacar un turno</span>
          <span
            class="icon-bubble !h-5 !w-5"
            style="background: rgba(122, 61, 46, 0.14);"
            aria-hidden="true"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M1 5h8M5 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>